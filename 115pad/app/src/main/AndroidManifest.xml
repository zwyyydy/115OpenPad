<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App115"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Open115">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              自定义协议，供磁力搜索工具等第三方 App 直接唤起：
                mypad://download?url=<urlencoded>
                pan115://download?url=<urlencoded>
              同时兼容把链接直接作为 path 的写法：mypad://download/<urlencoded>
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mypad" />
                <data android:scheme="pan115" />
            </intent-filter>

            <!--
              可选：直接接管 magnet: 隐式协议，让用户可以把本 App 选为默认磁力下载器。
              声明后点任意磁力链接都会出现在"打开方式"里。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- 系统"分享到"：接收其它 App 分享的纯文本（浏览器、社交软件等） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          播放器同时充当「外部播放器」：文件管理器点开视频、别的应用「分享到」视频都进这里。

          ⚠️ 这两个 intent-filter 必须挂在 PlayerActivity，**不能挂 MainActivity**：
             MainActivity.extractDownloadUrl 对任何未识别的 VIEW 都 `return data.toString()`
             当成下载链接提交到云端离线下载，视频 Uri 会被误投进去。
             现有 MainActivity 的 filter 只匹配 mypad:// / pan115:// / magnet: 和 SEND text/plain，
             不会截走视频，所以那边不用改。

          不限定 scheme：content://（下载文件给的是这个）、file://、http(s):// 都能进来。
        -->
        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true">

            <!-- 文件管理器 / 浏览器点开视频、音频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- 系统「分享到」：接收其它 App 分享的视频/音频（EXTRA_STREAM） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
