<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      任务常驻（设置 → 后台任务 → 「任务进行时防止被杀」）：
      扫描媒体库 / 上传 / 重命名期间挂一个前台服务，系统就不会随手回收进程。
      dataSync 对应"数据同步"这一类任务；Android 14 起这个类型要单独声明下面那条权限。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 前台服务的常驻通知（Android 13+ 要用户同意才显示；不同意也不影响服务本身） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      申请忽略电池优化：国产 ROM（华为/小米/OPPO/vivo…）光有前台服务还会被自家省电策略杀，
      加进白名单是第二层保底。只有用户在设置里主动开那个开关时才会弹系统确认框。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      播放器截图存相册用。Android 10（API 29）起 MediaStore 不需要任何权限，
      所以只在 28 及以下声明（maxSdkVersion 让新系统上这条权限根本不出现）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".App115"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Open115">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              自定义协议，供磁力搜索工具等第三方 App 直接唤起：
                mypad://download?url=<urlencoded>
                pan115://download?url=<urlencoded>
              同时兼容把链接直接作为 path 的写法：mypad://download/<urlencoded>
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mypad" />
                <data android:scheme="pan115" />
            </intent-filter>

            <!--
              可选：直接接管 magnet: 隐式协议，让用户可以把本 App 选为默认磁力下载器。
              声明后点任意磁力链接都会出现在"打开方式"里。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- 系统"分享到"：接收其它 App 分享的纯文本（浏览器、社交软件等） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          播放器同时充当「外部播放器」：文件管理器点开视频、别的应用「分享到」视频都进这里。

          ⚠️ 这两个 intent-filter 必须挂在 PlayerActivity，**不能挂 MainActivity**：
             MainActivity.extractDownloadUrl 对任何未识别的 VIEW 都 `return data.toString()`
             当成下载链接提交到云端离线下载，视频 Uri 会被误投进去。
             现有 MainActivity 的 filter 只匹配 mypad:// / pan115:// / magnet: 和 SEND text/plain，
             不会截走视频，所以那边不用改。

          不限定 scheme：content://（下载文件给的是这个）、file://、http(s):// 都能进来。
        -->
        <activity
            android:name=".player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true">

            <!-- 文件管理器 / 浏览器点开视频、音频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- 系统「分享到」：接收其它 App 分享的视频/音频（EXTRA_STREAM） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!--
          任务常驻服务（设置 → 后台任务 → 「任务进行时防止被杀」）：有任务时挂常驻通知保命。
          exported=false —— 只给自己用；类型 dataSync（上传/下载/扫描都属于这一类）。
        -->
        <service
            android:name=".data.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
